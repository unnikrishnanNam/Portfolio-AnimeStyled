---
import Art from '../Art.astro';
import EpisodeCard from '../EpisodeCard.astro';
import { bosses, finalBoss, bestiary } from '../../data/content.js';
---
<section class="sc battle on-dark" id="ep03" data-ep="ep03" data-fx="powerup" aria-labelledby="battle-h">
  <div class="wrap battle__intro">
    <EpisodeCard ep="ep03" dark />
    <p class="battle__lede" id="battle-h">Every project is a boss fight. Read the battle log, play the replay, drain the HP.</p>
    <ol class="roster" aria-label="Boss roster">
      {[...bosses, { ...finalBoss, n: 4 }].map((b) => (
        <li><a href={`#fight-${b.id}`} data-fight-jump={b.id}><span class="mono">{b.n === 4 ? 'FINAL' : `0${b.n}`}</span><b>{b.boss}</b><em>{b.project}</em></a></li>
      ))}
    </ol>
  </div>

  <div class="battle__pin">
    <div class="battle__track">
      {bosses.map((b) => (
        <article class="fight" id={`fight-${b.id}`} data-fight={b.id} data-fansub={b.intro} data-win={b.win}>
          <header class="fight__top">
            <p class="fight__no mono">BATTLE {b.n} / 4 · {b.project} · {b.year}</p>
            <div class="hp" role="meter" aria-label={`${b.boss} HP`} aria-valuemin="0" aria-valuemax="100" aria-valuenow="100">
              <span class="hp__label mono">{b.boss.replace('The ', '').toUpperCase()} · HP</span>
              <span class="hp__bar"><i></i><i class="hp__ghost"></i></span>
              <span class="hp__num mono">100</span>
            </div>
          </header>
          <div class="fight__body">
            <div class="fight__stage">
              <div class="fight__hero"><Art id="CH-04" sizes="(max-width: 1000px) 45vw, 22vw" alt="Our hero in battle stance, MacBook Pro raised like a shield" /></div>
              <span class="fight__vs" aria-hidden="true">VS</span>
              <div class="fight__boss"><Art id={b.art} sizes="(max-width: 1000px) 55vw, 30vw" alt={`${b.boss}, the monster version of the problem ${b.project} solves`} label={b.boss} /></div>
              <div class="ko" aria-hidden="true"><span>K.O.!</span></div>
              <div class="victory" aria-live="polite">
                <p class="victory__k">VICTORY</p>
                <dl>{b.victory.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
                <div class="victory__pose"><Art id="GIF-05" fallback="CH-03" sizes="160px" alt="Victory fist pump" label="fist pump" /></div>
              </div>
            </div>
            <div class="fight__side">
              <div class="log">
                <h3 class="log__boss">{b.boss}</h3>
                <dl class="log__dl">
                  <div><dt>Problem</dt><dd>{b.problem}</dd></div>
                  <div><dt>Moves</dt><dd>{b.moves}</dd></div>
                </dl>
                <ul class="chips log__stack">{b.stack.map((s) => <li class="chip">{s}</li>)}</ul>
                <a class="btn btn--sm btn--yellow log__repo" href={b.repo} target="_blank" rel="noopener">View the repo ↗</a>
              </div>

              {b.replay === 'interceptor' && (
                <div class="rp rp--icpt" data-replay="interceptor">
                  <div class="rp__bar mono"><i></i><i></i><i></i><span>REPLAY · psql → interceptor → postgres</span></div>
                  <form class="rp__prompt mono">
                    <label for="icpt-q">prod=#</label>
                    <input id="icpt-q" value="DROP TABLE users;" spellcheck="false" autocomplete="off" />
                    <button class="btn btn--sm btn--yellow" type="submit">Run</button>
                  </form>
                  <div class="rp__lane mono" aria-hidden="true">
                    <span class="rp__node">psql</span>
                    <span class="rp__wire"><span class="rp__pkt"></span></span>
                    <span class="rp__node rp__proxy">Interceptor</span>
                    <span class="rp__wire rp__wire--2"></span>
                    <span class="rp__node rp__db">▦ users</span>
                  </div>
                  <div class="rp__hold" hidden>
                    <span class="mono">HELD · waiting for an Admin or Peer</span>
                    <span class="rp__btns"><button class="btn btn--sm" type="button" data-approve>Approve</button><button class="btn btn--sm btn--ink" type="button" data-deny>Deny</button></span>
                  </div>
                  <p class="rp__log mono" aria-live="polite">Type a query and press Run. Try SELECT too.</p>
                </div>
              )}

              {b.replay === 'vm' && (
                <div class="rp rp--vm" data-replay="vm">
                  <div class="rp__bar mono"><i></i><i></i><i></i><span>REPLAY · vm-provisioner · 4× speed</span></div>
                  <div class="rp__row">
                    <button class="btn btn--sm btn--yellow" type="button" data-summon>Summon VM</button>
                    <span class="rp__timer mono">t = <b>0.0</b> s</span>
                  </div>
                  <ol class="rp__steps mono">
                    <li>POST /vms · queued on RabbitMQ</li>
                    <li>Worker picks up the job</li>
                    <li>Clone QCOW2 base image</li>
                    <li>Inject cloud-init: user, SSH key, packages</li>
                    <li>virsh start · booting</li>
                    <li>Ready · ssh dev@10.0.0.42</li>
                  </ol>
                </div>
              )}

              {b.replay === 'queuectl' && (
                <div class="rp rp--q" data-replay="queuectl">
                  <div class="rp__bar mono"><i></i><i></i><i></i><span>REPLAY · queuectl · 3 virtual-thread workers</span></div>
                  <div class="q mono">
                    <div class="q__col"><h5>pending</h5><ul data-q="pending"></ul></div>
                    <div class="q__col q__workers"><h5>workers</h5><ul data-q="workers"><li data-w="1"><b>w1</b><span></span></li><li data-w="2"><b>w2</b><span></span></li><li data-w="3"><b>w3</b><span></span></li></ul></div>
                    <div class="q__col"><h5>done</h5><p data-q="done">0</p><h5>dead letter</h5><ul data-q="dlq"></ul></div>
                  </div>
                  <div class="rp__row">
                    <button class="btn btn--sm btn--yellow" type="button" data-enqueue>Enqueue 8 jobs</button>
                    <span class="rp__timer mono">duplicate claims: <b data-q="dupes">0</b></span>
                  </div>
                  <p class="rp__log mono" aria-live="polite">UPDATE jobs SET state='running' WHERE id=? AND state='pending'</p>
                </div>
              )}
            </div>
          </div>
        </article>
      ))}

      <article class="fight fight--final" id={`fight-${finalBoss.id}`} data-fight="opscope" data-fansub="This battle is still being fought. One commit at a time.">
        <header class="fight__top">
          <p class="fight__no mono">FINAL BOSS · {finalBoss.project} · {finalBoss.year}</p>
          <div class="hp hp--final" role="meter" aria-label="CrashLoop Hydra HP, battle in progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="60">
            <span class="hp__label mono">CRASHLOOP HYDRA · BATTLE IN PROGRESS</span>
            <span class="hp__bar"><i></i></span>
            <span class="hp__num mono">∞</span>
          </div>
        </header>
        <div class="fight__body">
          <div class="fight__stage fight__stage--final">
            <div class="fight__arena" aria-hidden="true"><Art id="BG-05" sizes="(max-width: 1000px) 100vw, 56vw" alt="" /></div>
            <div class="fight__screen"><Art id="SCR-01" sizes="(max-width: 1000px) 80vw, 34vw" alt="Opscope screenshot: a live Kubernetes topology graph" label="your Opscope screenshot" /></div>
            <div class="fight__hero"><Art id="CH-04" sizes="(max-width: 1000px) 45vw, 22vw" alt="Our hero raising the Opscope lens" /></div>
            <svg class="lens" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="40" /><circle class="lens__pupil" cx="50" cy="50" r="13" /><path d="M50 10 V-30" /></svg>
            <div class="fight__boss"><Art id={finalBoss.art} sizes="(max-width: 1000px) 60vw, 34vw" alt="The CrashLoop Hydra, a many-headed serpent made of shipping containers" /></div>
          </div>
          <div class="fight__side">
            <div class="log">
              <h3 class="log__boss">{finalBoss.boss}</h3>
              <dl class="log__dl">
                <div><dt>Problem</dt><dd>{finalBoss.problem}</dd></div>
                <div><dt>Moves</dt><dd>{finalBoss.moves}</dd></div>
                <div><dt>Status</dt><dd>Battle in progress. Never K.O.’d, by design.</dd></div>
              </dl>
              <ul class="chips log__stack">{finalBoss.stack.map((s) => <li class="chip">{s}</li>)}</ul>
              <a class="btn btn--sm btn--yellow log__repo" href={finalBoss.repo} target="_blank" rel="noopener">Follow the repo ↗</a>
            </div>
            <div class="rp rp--topo" data-replay="opscope">
              <div class="rp__bar mono"><i></i><i></i><i></i><span>REPLAY · opscope · cluster kerala-prod</span></div>
              <svg class="topo" viewBox="0 0 320 150" role="img" aria-label="Topology: ingress, service, deployment, three pods and a database. One pod is crash-looping.">
                <g class="topo__edges">
                  <path d="M40 75 H100" /><path d="M140 75 H170" /><path d="M210 75 L250 30" /><path d="M210 75 H250" /><path d="M210 75 L250 120" /><path d="M270 30 L300 75" /><path d="M270 75 H300" /><path d="M270 120 L300 75" />
                </g>
                <g class="topo__nodes mono">
                  <g transform="translate(20 75)"><circle r="16" /><text>ing</text></g>
                  <g transform="translate(120 75)"><circle r="16" /><text>svc</text></g>
                  <g transform="translate(190 75)"><circle r="16" /><text>dep</text></g>
                  <g class="pod" data-pod="0" transform="translate(260 30)"><circle r="12" /><text>p1</text></g>
                  <g class="pod" data-pod="1" transform="translate(260 75)"><circle r="12" /><text>p2</text></g>
                  <g class="pod" data-pod="2" transform="translate(260 120)"><circle r="12" /><text>p3</text></g>
                  <g transform="translate(305 75)"><circle r="12" /><text>db</text></g>
                </g>
              </svg>
              <div class="rp__row">
                <button class="btn btn--sm btn--yellow" type="button" data-fix>One-click fix</button>
                <span class="rp__ok" aria-hidden="true">OK.</span>
              </div>
              <p class="rp__log mono" aria-live="polite">p2: CrashLoopBackOff · why: missing secret db-creds</p>
            </div>
          </div>
        </div>
      </article>

      <article class="fight fight--bestiary" id="bestiary" data-fansub="Smaller monsters. One click each.">
        <header class="fight__top">
          <p class="fight__no mono">BESTIARY · SIDE QUESTS</p>
        </header>
        <div class="beasts">
          {bestiary.map((m) => (
            <div class="beast">
              <div class="beast__art"><Art id={m.art} sizes="200px" alt={m.name} label={m.name} /></div>
              <h4>{m.name}</h4>
              <p class="beast__proj mono">{m.project}</p>
              <p class="beast__txt">{m.text}</p>
              <div class="beast__foot">
                <button class="btn btn--sm" type="button" data-oneclick>One-click fix</button>
                {m.repo && <a class="beast__repo mono" href={m.repo} target="_blank" rel="noopener">repo ↗</a>}
              </div>
              <span class="beast__ok" aria-hidden="true"><Art id="CH-08" sizes="120px" alt="" label="deadpan OK face" /><b>OK.</b></span>
            </div>
          ))}
          <div class="beast beast--cross">
            <p class="beast__proj mono">CROSSOVER EPISODE · JAN – FEB 2026</p>
            <h4>Whatomate × Zerodha</h4>
            <p class="beast__big">−50%</p>
            <p class="beast__txt">DB queries per webhook event, after refactoring the campaign-status hot path in Go to use PostgreSQL’s <code>RETURNING</code>. Merged under Zerodha’s code review.</p>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style is:global>
  .battle { background: #120c10; color: var(--paper); --accent: var(--red); }
  .battle::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse at 80% 0, rgba(229, 50, 45, .28), transparent 55%), radial-gradient(ellipse at 0 100%, rgba(46, 155, 235, .18), transparent 50%); }
  .battle__intro { position: relative; padding-bottom: clamp(30px, 6vh, 60px); }
  .battle__lede { margin: 0 0 26px; max-width: 46ch; font-size: clamp(18px, 1.6vw, 24px); font-weight: 700; }
  .roster { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .roster a { display: grid; gap: 2px; height: 100%; padding: 14px 16px; border: 2px solid rgba(251, 248, 241, .25); border-radius: 12px; text-decoration: none; transition: border-color .2s, background .2s, transform .2s var(--ease-out); }
  .roster a:hover { border-color: var(--red); background: rgba(229, 50, 45, .12); transform: translateY(-3px); }
  .roster span { color: var(--red); font-size: 12px; letter-spacing: .2em; }
  .roster b { font-family: var(--f-display); font-weight: 400; font-size: clamp(15px, 1.3vw, 19px); line-height: 1.15; }
  .roster em { font-style: normal; opacity: .65; font-size: 13px; }

  .battle__pin { position: relative; }
  .battle__track { display: grid; gap: clamp(60px, 10vh, 120px); padding-block: 20px 120px; }
  .fight { position: relative; width: min(1240px, 100% - var(--gutter) * 2); margin-inline: auto; display: grid; gap: 16px; }
  .fight__top { display: grid; gap: 8px; }
  .fight__no { margin: 0; font-size: 12px; letter-spacing: .2em; color: #ff9d8a; }
  .hp { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 12px; }
  .hp__label { font-size: 12px; letter-spacing: .12em; white-space: nowrap; }
  .hp__bar { position: relative; height: 16px; border: 2px solid var(--paper); border-radius: 3px; background: #2a0d0d; overflow: hidden; transform: skewX(-18deg); }
  .hp__bar i { position: absolute; inset: 0; transform-origin: left; background: linear-gradient(#ffe066, #f2a10f); }
  .hp__bar .hp__ghost { display: none; }
  .hp__num { min-width: 3ch; text-align: right; font-weight: 700; color: var(--yellow); }
  .hp--final .hp__bar i { background: linear-gradient(#ff8a4d, var(--red)); transform: scaleX(.62); animation: regen 2.4s ease-in-out infinite; }
  @keyframes regen { 0%, 100% { transform: scaleX(.62); } 45% { transform: scaleX(.38); } 70% { transform: scaleX(.7); } }

  .fight__body { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(16px, 2.4vw, 32px); align-items: stretch; }
  .fight__stage { position: relative; min-height: 420px; border: 3px solid var(--paper); border-radius: 18px; overflow: hidden; background: linear-gradient(115deg, #1c2147 0 49.6%, var(--paper) 49.6% 50.4%, #5a0f12 50.4%); }
  .fight__stage::before { content: ''; position: absolute; inset: 0; color: rgba(255, 255, 255, .07); background: radial-gradient(circle, currentColor 1.2px, transparent 1.6px) 0 0 / 8px 8px; }
  .fight__hero { position: absolute; left: 2%; bottom: 0; height: 88%; aspect-ratio: 1050 / 1403; z-index: 2; }
  .fight__boss { position: absolute; right: 1%; top: 6%; bottom: 4%; width: 56%; z-index: 1; }
  .fight__hero .art, .fight__hero img, .fight__boss .art, .fight__boss img { width: 100%; height: 100%; }
  .fight__hero img { object-fit: contain; object-position: bottom left; filter: drop-shadow(6px 6px 0 rgba(0, 0, 0, .55)); }
  .fight__boss img { object-fit: contain; filter: drop-shadow(0 0 30px rgba(255, 60, 60, .35)); }
  .fight__vs { position: absolute; left: 60%; top: 9%; z-index: 3; transform: translate(-50%, -50%) rotate(-8deg); font-family: var(--f-display); font-size: clamp(40px, 5vw, 76px); color: var(--yellow); -webkit-text-stroke: 4px var(--ink); paint-order: stroke fill; text-shadow: 5px 5px 0 var(--ink); }
  .ko { position: absolute; inset: 0; z-index: 5; display: grid; place-items: center; pointer-events: none; }
  .ko span { font-family: var(--f-display); font-size: clamp(70px, 10vw, 150px); color: var(--red); -webkit-text-stroke: 6px var(--paper); paint-order: stroke fill; text-shadow: 8px 8px 0 var(--ink); transform: scale(0) rotate(-14deg); }
  .victory { position: absolute; right: 4%; bottom: 5%; z-index: 6; width: min(360px, 78%); padding: 16px 18px; background: var(--paper); color: var(--ink); border: 3px solid var(--ink); border-radius: 14px; box-shadow: 8px 8px 0 var(--yellow); opacity: 0; transform: translateY(30px) scale(.9); visibility: hidden; }
  .victory__k { margin: 0 0 8px; font-family: var(--f-display); font-size: 26px; color: var(--red); letter-spacing: .06em; }
  .victory dl { margin: 0; display: grid; gap: 4px; }
  .victory dl div { display: grid; grid-template-columns: 7.5em 1fr; gap: 8px; font-size: 13.5px; }
  .victory dt { opacity: .6; }
  .victory dd { margin: 0; font-weight: 700; }
  .victory__pose { position: absolute; right: -14px; top: -78px; width: 104px; filter: drop-shadow(3px 3px 0 var(--ink)); }
  .victory__pose .art--todo { aspect-ratio: 1; min-height: 0; font-size: 9px; }

  .fight__side { display: grid; gap: 14px; align-content: start; }
  .log { padding: 18px 20px; border: 2px solid rgba(251, 248, 241, .22); border-radius: 16px; background: rgba(255, 255, 255, .04); }
  .log__boss { margin: 0 0 10px; font-family: var(--f-display); font-weight: 400; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.1; }
  .log__dl { margin: 0 0 12px; display: grid; gap: 8px; }
  .log__dl div { display: grid; grid-template-columns: 5.6em 1fr; gap: 10px; font-size: 15px; line-height: 1.45; }
  .log__dl dt { color: #ff9d8a; font-family: var(--f-mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; padding-top: 3px; }
  .log__dl dd { margin: 0; }
  .log__stack { margin-bottom: 14px; color: #cfc8d8; }

  .rp { border: 2px solid rgba(251, 248, 241, .22); border-radius: 16px; background: #0b0a0e; overflow: hidden; font-size: 13px; }
  .rp__bar { display: flex; align-items: center; gap: 6px; padding: 8px 12px; background: #17151c; border-bottom: 1px solid #26232c; font-size: 11px; color: #8d8899; }
  .rp__bar i { width: 9px; height: 9px; border-radius: 50%; background: #3a3641; }
  .rp__bar i:first-child { background: #ff5f57; } .rp__bar i:nth-child(2) { background: #febc2e; } .rp__bar i:nth-child(3) { background: #28c840; }
  .rp__bar span { margin-left: 6px; }
  .rp__prompt { display: flex; align-items: center; gap: 8px; padding: 12px; }
  .rp__prompt label { color: var(--yellow); }
  .rp__prompt input { flex: 1; min-width: 0; padding: 7px 10px; border: 1px solid #2c2933; border-radius: 8px; background: #121016; font-family: var(--f-mono); font-size: 13px; }
  .rp__lane { position: relative; display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: center; gap: 6px; padding: 8px 12px 14px; }
  .rp__node { padding: 5px 9px; border: 1.5px solid #4a4652; border-radius: 8px; background: #16141b; font-size: 11.5px; white-space: nowrap; }
  .rp__proxy { border-color: var(--yellow); color: var(--yellow); }
  .rp__db.is-dropped { border-color: var(--red); color: var(--red); text-decoration: line-through; }
  .rp__wire { position: relative; height: 2px; background: repeating-linear-gradient(90deg, #4a4652 0 6px, transparent 6px 10px); }
  .rp__pkt { position: absolute; left: 0; top: 50%; transform: translate(0, -50%); padding: 2px 6px; border-radius: 6px; background: var(--red); color: #fff; font-size: 10.5px; white-space: nowrap; opacity: 0; }
  .rp__pkt.is-safe { background: #2f9e6a; }
  .rp__hold { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin: 0 12px 10px; padding: 9px 12px; border: 1.5px dashed var(--yellow); border-radius: 10px; color: var(--yellow); font-size: 12px; }
  .rp__btns { display: flex; gap: 6px; }
  .rp__log { margin: 0; padding: 10px 12px; border-top: 1px solid #1f1c24; color: #9fe39a; font-size: 12px; min-height: 2.6em; }
  .rp__row { display: flex; align-items: center; gap: 12px; padding: 12px; }
  .rp__timer { color: #b9b3c5; }
  .rp__timer b { color: var(--yellow); }
  .rp__steps { margin: 0; padding: 0 12px 14px 36px; display: grid; gap: 5px; color: #6f6a78; font-size: 12px; }
  .rp__steps li.is-on { color: #e7e2ef; }
  .rp__steps li.is-done { color: #9fe39a; }
  .rp__steps li.is-done::marker { content: '✓  '; }
  .q { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; padding: 12px; }
  .q h5 { margin: 0 0 6px; font-size: 10.5px; font-weight: 400; letter-spacing: .14em; color: #8d8899; text-transform: uppercase; }
  .q ul { list-style: none; margin: 0 0 8px; padding: 0; display: flex; flex-wrap: wrap; gap: 4px; min-height: 24px; }
  .q [data-q="pending"] li, .q [data-q="dlq"] li { padding: 2px 6px; border-radius: 5px; background: #24212b; font-size: 10.5px; }
  .q [data-q="dlq"] li { background: #4a1414; color: #ffb3a8; }
  .q__workers ul { display: grid; gap: 4px; }
  .q__workers li { display: flex; gap: 6px; align-items: center; padding: 4px 6px; border: 1px solid #2c2933; border-radius: 6px; font-size: 11px; }
  .q__workers li b { color: var(--yellow); font-weight: 700; }
  .q__workers li.is-busy { border-color: #4fd1a5; }
  .q__workers li.is-fail { border-color: var(--red); }
  .q [data-q="done"] { margin: 0 0 10px; font-family: var(--f-display); font-size: 26px; color: #9fe39a; line-height: 1; }

  .fight--final .fight__stage { background: radial-gradient(ellipse at 70% 40%, #7a1410, #2a0606 70%); }
  .fight__arena, .fight__arena .art, .fight__arena img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fight__arena img { object-fit: cover; object-position: 50% 70%; filter: saturate(1.1) brightness(.62); }
  .fight__arena::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 62% 45%, transparent 30%, rgba(20, 4, 8, .55) 100%); }
  .fight--final .fight__stage::before { z-index: 1; }
  .fight__screen { position: absolute; right: 4%; bottom: 5%; width: 38%; z-index: 3; transform: rotate(3deg); border: 3px solid var(--paper); border-radius: 10px; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 0, 0, .5); }
  .fight__screen .art--todo { aspect-ratio: 16 / 10; min-height: 0; border: 0; border-radius: 0; }
  .fight--final .fight__hero { height: 72%; left: -2%; }
  .fight--final .fight__boss { width: 74%; right: -4%; top: 2%; bottom: 14%; }
