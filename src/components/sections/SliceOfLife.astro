---
import Art from '../Art.astro';
import EpisodeCard from '../EpisodeCard.astro';
import { photos, sideQuests, nightstand } from '../../data/content.js';
const loop = 'OFF DUTY ★ ഒഴിവുസമയം ★ ';
---
<section class="sc slice" id="ep05" data-ep="ep05" data-fx="eyecatch" data-ec="2" aria-labelledby="slice-h">
  <div class="slice__sky" aria-hidden="true"><i class="slice__moon"></i></div>
  <p class="slice__marquee" aria-hidden="true"><span>{loop.repeat(6)}</span></p>

  <div class="wrap slice__head">
    <EpisodeCard ep="ep05" dark />
    <p class="slice__lede" id="slice-h">After hours: drone flights, hill walks, the squad, a few side quests, and a Shih Tzu who takes her job very seriously.</p>
  </div>

  <div class="wrap">
    <div class="page" data-fansub="Off duty. Muffins is still on duty.">
      {photos.map((p) => (
        <figure class={`scene scene--${p.art}`}>
          <div class="scene__frame">
            <div class="scene__art" style={`--pos:${p.pos}`}><Art id={p.art} fallback={p.fallback} sizes="(max-width: 900px) 92vw, 40vw" alt={p.caption} label="your photo, restyled" /></div>
            <i class="scene__tone" aria-hidden="true"></i>
          </div>
          <figcaption class="caption-box">{p.caption}</figcaption>
          <span class="sfx" aria-hidden="true">{p.sfx}</span>
        </figure>
      ))}

      <div class="page__drone" aria-hidden="true"><Art id="DRONE-01" sizes="160px" alt="" /></div>

      <button class="scene nap" type="button" aria-label="Muffins, asleep in her bean bag. Click to wake her.">
        <span class="scene__frame nap__frame">
          <span class="nap__glow" aria-hidden="true"></span>
          <span class="nap__dog nap__dog--sleep"><Art id="MUF-02" fallback="MUF-01" sizes="(max-width: 900px) 70vw, 26vw" alt="" /></span>
          <span class="nap__dog nap__dog--awake"><Art id="MUF-01" sizes="(max-width: 900px) 40vw, 14vw" alt="" /></span>
        </span>
        <span class="caption-box">Muffins. Off duty. Still on duty.</span>
        <span class="nap__z" aria-hidden="true">z<b>z</b><i>z</i></span>
        <span class="nap__count mono" aria-live="polite"></span>
      </button>
    </div>

    <div class="quests">
      <div class="quests__log">
        <p class="quests__k mono">SIDE QUESTS · IN PROGRESS</p>
        <ol>
          {sideQuests.map((q) => (
            <li><b>{q.name}</b><span>{q.text}</span><i class="quests__bar" aria-hidden="true"><i></i></i></li>
          ))}
        </ol>
      </div>
      <div class="quests__read">
        <p class="quests__k mono">ON THE NIGHTSTAND</p>
        <p class="quests__book">{nightstand}</p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* EP.05 is the night episode: indigo sky, cream manga panels, yellow sound effects. */
  .slice { --night-1: #121433; --night-2: #2b2257; background: linear-gradient(180deg, var(--night-1), var(--night-2) 70%, #3b2a5e); color: var(--paper); padding-bottom: clamp(80px, 12vh, 140px); overflow: hidden; --accent: var(--yellow); }
  .slice__sky { position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(1.5px 1.5px at 12% 14%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 28% 8%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 46% 20%, #fff8 50%, transparent 51%),
      radial-gradient(1px 1px at 63% 11%, #fff 50%, transparent 51%),
      radial-gradient(2px 2px at 81% 26%, #fff9 50%, transparent 51%),
      radial-gradient(1px 1px at 92% 6%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 7% 46%, #fff7 50%, transparent 51%),
      radial-gradient(1px 1px at 55% 52%, #fff6 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 96% 58%, #fff7 50%, transparent 51%),
      radial-gradient(circle, rgba(255, 255, 255, .05) 1px, transparent 1.4px) 0 0 / 7px 7px; }
  .slice__moon { position: absolute; right: 9%; top: 70px; width: clamp(70px, 9vw, 130px); aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle at 38% 38%, #fff8dc, #ffe9a8 60%, #f3cf6c); box-shadow: 0 0 60px 18px rgba(255, 226, 140, .22), inset -14px -10px 0 rgba(200, 160, 70, .25); }
  .slice__marquee { position: absolute; left: 0; top: 34%; margin: 0; white-space: nowrap; pointer-events: none; font-family: var(--f-display); font-size: clamp(80px, 15vw, 240px); line-height: 1; color: transparent; -webkit-text-stroke: 2px rgba(251, 248, 241, .08); }
  .slice__marquee span { display: inline-block; will-change: transform; }

  .slice__head { position: relative; }
  .slice__lede { margin: 0 0 clamp(36px, 6vh, 64px); max-width: 52ch; font-size: clamp(17px, 1.5vw, 22px); font-weight: 700; color: #e6e1f5; }

  /* Manga page */
  .page { position: relative; display: grid; grid-template-columns: 1.35fr 1fr 1fr; grid-template-rows: minmax(300px, 44vh) minmax(260px, 38vh); gap: 18px; }
  .scene { position: relative; margin: 0; min-width: 0; }
  .scene--PH-01 { grid-area: 1 / 1; }
  .scene--PH-03 { grid-area: 1 / 2; }
  .scene--PH-02 { grid-area: 1 / 3 / span 2; }
  .nap { grid-area: 2 / 1; }
  .scene--PH-04 { grid-area: 2 / 2; }
  .scene__frame { position: absolute; inset: 0; display: block; overflow: hidden; border: 3px solid var(--paper); border-radius: 4px; background: #1c1a3a; box-shadow: 8px 8px 0 rgba(5, 4, 20, .55); }
  .scene__art { position: absolute; inset: -8% 0; }
  .scene__art .art, .scene__art img { width: 100%; height: 100%; }
  .scene__art img { object-fit: cover; object-position: var(--pos, 50% 50%); transition: transform .6s var(--ease-out); }
  .scene__art .art--todo { border: 0; border-radius: 0; }
  .scene__tone { position: absolute; inset: 0; opacity: 0; color: rgba(22, 19, 28, .35); background: radial-gradient(circle, currentColor 1.1px, transparent 1.5px) 0 0 / 6px 6px; transition: opacity .3s; pointer-events: none; }
  .scene:hover .scene__art img { transform: scale(1.06); }
  .scene:hover .scene__tone { opacity: 1; }
  .scene > .caption-box { position: absolute; left: 12px; bottom: 12px; z-index: 2; max-width: min(78%, 300px); font-size: clamp(12px, .95vw, 14px); }
  .sfx { position: absolute; right: -10px; top: -18px; z-index: 3; font-family: var(--f-display); font-size: clamp(28px, 3.3vw, 54px); line-height: 1; color: var(--yellow); -webkit-text-stroke: 5px var(--ink); paint-order: stroke fill; text-shadow: 4px 4px 0 var(--ink); transform: rotate(-9deg); pointer-events: none; }
  .scene--PH-03 .sfx { color: #ff8fb1; transform: rotate(7deg); }
  .scene--PH-02 .sfx { top: 30%; right: -16px; color: #9fe0ff; transform: rotate(-80deg); transform-origin: right top; }
  .scene--PH-04 .sfx { top: -16px; right: -14px; color: #ffb35c; transform: rotate(-6deg); }
  .scene:hover .sfx { animation: sfx-wiggle .4s ease-in-out; }
  @keyframes sfx-wiggle { 30% { translate: -3px 2px; } 60% { translate: 3px -2px; } }

  /* The drone flies out of the first panel. */
  .page__drone { position: absolute; z-index: 4; left: 4%; top: -34px; width: clamp(90px, 10vw, 150px); pointer-events: none; animation: drone-bob 2.6s ease-in-out infinite; filter: drop-shadow(0 14px 10px rgba(0, 0, 0, .45)); }
  .page__drone img { width: 100%; height: auto; }
  @keyframes drone-bob { 50% { transform: translateY(-10px) rotate(-4deg); } }

  /* Muffins' nap panel (click five times to wake her). */
  .nap { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .nap__frame { background: radial-gradient(ellipse at 50% 85%, #4b3a8c, #1c1a3a 70%); }
  .nap__glow { position: absolute; left: 50%; bottom: -30%; width: 90%; aspect-ratio: 1; transform: translateX(-50%); border-radius: 50%; background: radial-gradient(circle, rgba(255, 210, 120, .35), transparent 65%); }
  .nap__dog { position: absolute; transition: opacity .3s, transform .45s var(--ease-out); }
  .nap__dog .art, .nap__dog img { width: 100%; height: 100%; }
  .nap__dog img { object-fit: contain; object-position: 50% 100%; }
  .nap__dog--sleep { left: 10%; right: 10%; top: 14%; bottom: 4%; }
  .nap__dog--sleep img { filter: drop-shadow(0 10px 14px rgba(0, 0, 0, .5)); }
  .nap__dog--sleep:has([data-want]) { transform: rotate(-80deg) scale(.7); }
  .nap__dog--awake { left: 30%; right: 30%; top: 8%; bottom: 6%; opacity: 0; transform: translateY(20%) scale(.9); }
  .nap.is-awake .nap__dog--awake { opacity: 1; transform: translateY(-4%) scale(1.04); }
  .nap.is-awake .nap__dog--sleep, .nap.is-awake .nap__z { opacity: 0; }
  .nap.is-awake .nap__dog--sleep { transform: scale(.94, .86); transform-origin: 50% 100%; }
  .nap > .caption-box { position: absolute; left: 12px; top: 12px; bottom: auto; z-index: 2; font-size: clamp(12px, .95vw, 14px); }
  .nap__z { position: absolute; right: 14%; top: 18%; z-index: 2; font-family: var(--f-display); font-size: 26px; color: #cfe0ff; text-shadow: 0 0 12px rgba(160, 190, 255, .6); }
  .nap__z b, .nap__z i { font-weight: 400; font-style: normal; display: inline-block; animation: zz 1.8s ease-in-out infinite; }
  .nap__z i { animation-delay: .3s; font-size: .8em; }
  .nap__count { position: absolute; right: 12px; bottom: 12px; z-index: 2; padding: 3px 8px; border-radius: 99px; background: rgba(5, 4, 20, .6); font-size: 12px; color: var(--yellow); }
  .nap__count:empty { display: none; }
  .nap:focus-visible .scene__frame { outline: 3px solid var(--yellow); outline-offset: 4px; }

  /* Side quests: a night-mode quest log under the page. */
  .quests { display: grid; grid-template-columns: 1.6fr 1fr; gap: 18px; margin-top: 28px; }
  .quests > div { padding: clamp(18px, 2.2vw, 26px); border: 2px solid rgba(251, 248, 241, .18); border-radius: 18px; background: rgba(10, 9, 30, .55); backdrop-filter: blur(6px); }
  .quests__k { margin: 0 0 12px; font-size: 11px; letter-spacing: .24em; color: var(--yellow); }
  .quests ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .quests li { display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 4px 12px; }
  .quests li b { font-family: var(--f-display); font-weight: 400; font-size: clamp(16px, 1.4vw, 20px); }
  .quests li span { color: #c9c3dd; font-size: 14.5px; }
  .quests__bar { grid-column: 1 / -1; display: block; height: 6px; border-radius: 99px; background: rgba(255, 255, 255, .1); overflow: hidden; }
  .quests__bar i { display: block; height: 100%; width: 100%; background: repeating-linear-gradient(-45deg, var(--yellow) 0 10px, #f5b82e 10px 20px); background-size: 28px 100%; animation: quest-load 1.1s linear infinite; }
  @keyframes quest-load { to { background-position: 28px 0; } }
  .quests__book { margin: 0; font-weight: 700; font-size: clamp(16px, 1.3vw, 19px); line-height: 1.45; }

  @media (max-width: 900px) {
    .page { grid-template-columns: 1fr 1fr; grid-template-rows: none; gap: 14px; }
    .scene { min-height: 0; }
    .scene--PH-01 { grid-area: auto; grid-column: 1 / -1; aspect-ratio: 4 / 3; }
    .scene--PH-03, .scene--PH-02, .scene--PH-04, .nap { grid-area: auto; aspect-ratio: 4 / 5; }
    .sfx { font-size: clamp(24px, 7vw, 36px); right: -4px; top: -14px; }
    .scene--PH-02 .sfx { top: -14px; right: auto; left: -6px; transform: rotate(-8deg); }
    .scene--PH-04 .sfx { right: -6px; }
    .page__drone { left: 2%; top: -44px; width: 84px; }
    .quests { grid-template-columns: 1fr; }
    .slice__marquee { top: 18%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .page__drone, .quests__bar i, .nap__z b, .nap__z i { animation: none; }
  }
</style>
