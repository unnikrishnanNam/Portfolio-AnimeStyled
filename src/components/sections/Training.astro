---
import Art from '../Art.astro';
import EpisodeCard from '../EpisodeCard.astro';
import { routine, skills, licenses, protocols } from '../../data/content.js';
---
<section class="sc training on-dark" id="ep02" data-ep="ep02" data-fx="screentone" aria-labelledby="training-h">
  <div class="training__bg" aria-hidden="true"><Art id="BG-04" sizes="100vw" alt="" label="server-rack dojo" /></div>
  <div class="wrap">
    <EpisodeCard ep="ep02" dark />

    <ol class="routine" aria-label="Daily training routine" data-fansub="Every single day. Even on weekends.">
      {routine.map((r) => <li>{r}</li>)}
    </ol>

    <div class="status" id="training-h" data-fansub="Rank S in Kubernetes. Rank ??? in Swift.">
      <div class="status__win">
        <header class="status__head">
          <span class="mono">STATUS</span>
          <h3>unnikrishnan</h3>
          <dl class="status__meta">
            <div><dt>Class</dt><dd>Platform Engineer</dd></div>
            <div><dt>Guild</dt><dd>Kalkitech · Energy IoT</dd></div>
            <div><dt>Sidekick</dt><dd>Muffins (Shih Tzu)</dd></div>
          </dl>
        </header>
        <div class="status__cols">
          <ul class="tech" aria-label="Techniques">
            <li class="tech__head mono" aria-hidden="true"><span>TECHNIQUE</span><span>RANK</span></li>
            {skills.map((s) => (
              <li>
                <button class="tech__row" type="button" data-form={s.form} data-loop={s.loop} data-rank={s.rank} aria-describedby="form-live">
                  <span class="tech__name">{s.name}</span>
                  <span class="tech__bar" aria-hidden="true"><i style={`--lv:${s.level}`}></i></span>
                  <span class:list={['tech__rank', { 'is-q': s.rank === '???' }]}>{s.rank}</span>
                </button>
              </li>
            ))}
          </ul>
          <div class="status__side">
            <div class="loopbox" aria-live="polite">
              <div class="loopbox__item is-on" data-loopbox="GIF-03"><Art id="GIF-03" sizes="320px" alt="Our hero typing furiously on the MacBook" label="furious typing loop" /></div>
              <div class="loopbox__item" data-loopbox="R-01"><Art id="R-01" sizes="320px" alt="Our hero, confused, eyes turning into spirals" /></div>
              <p class="loopbox__cap mono">hover a technique</p>
            </div>
          </div>
        </div>
        <div class="status__row">
          <h4 class="mono">LICENSES</h4>
          <ul class="licenses">
            {licenses.map((l) => (
              <li class:list={['lic', `lic--${l.state}`]} data-lic={l.name}>
                <b>{l.name}</b><span>{l.note}</span>
                {l.state === 'charging' && <i class="lic__charge" aria-hidden="true"></i>}
              </li>
            ))}
          </ul>
        </div>
        <div class="status__row">
          <h4 class="mono">LANGUAGES KNOWN</h4>
          <p class="status__langs">Java, Go, TypeScript, Python, SQL, Kotlin. And, at work, the dialects of the power grid: {protocols.map((p, i) => <><span class="chip">{p}</span>{i < protocols.length - 1 ? ' ' : ''}</>)}</p>
        </div>
      </div>
    </div>

    <div class="cka" aria-label="CKA passed">
      <p class="cka__pre mono">FINAL EXAM · CERTIFIED KUBERNETES ADMINISTRATOR</p>
      <div class="cka__stamp" data-cka><span>CKA</span><small>PASSED · 2026</small></div>
    </div>
  </div>
  <div class="form-flash" id="form-flash" aria-hidden="true"><p></p></div>
  <p class="sr-only" id="form-live" aria-live="polite"></p>
</section>

<style is:global>
  .training { background: #0f1214; color: var(--paper); padding-bottom: clamp(120px, 22vh, 240px); --accent: var(--yellow); }
  .training__bg { position: absolute; inset: 0; opacity: .38; }
  .training__bg .art, .training__bg img { width: 100%; height: 100%; }
  .training__bg img { object-fit: cover; }
  .training__bg .art--todo { border: 0; border-radius: 0; background: linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px) 0 0 / 80px 100%, linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px) 0 0 / 100% 40px, radial-gradient(ellipse at 50% 0, #1d3a30, transparent 70%); }
  .training__bg .art--todo span { position: absolute; top: 16px; right: 16px; }
  .training::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(#0f1214 0, transparent 30%, transparent 70%, #0f1214 100%); }
  .training .wrap { position: relative; z-index: 1; }

  .routine { list-style: none; margin: 0 0 clamp(60px, 10vh, 120px); padding: 0; display: grid; gap: .1em; font-family: var(--f-display); font-size: clamp(28px, 5.2vw, 84px); line-height: 1.04; text-transform: uppercase; }
  .routine li:nth-child(odd) { color: var(--yellow); }
  .routine li:last-child { color: var(--paper); font-size: .5em; letter-spacing: .1em; padding-top: .4em; }

  .status__win { position: relative; padding: clamp(18px, 3vw, 36px); border: 2px solid rgba(160, 240, 210, .55); border-radius: 18px; background: linear-gradient(160deg, rgba(20, 60, 52, .72), rgba(8, 18, 20, .86)); box-shadow: 0 0 0 6px rgba(160, 240, 210, .08), 0 30px 80px rgba(0, 0, 0, .45), inset 0 0 60px rgba(120, 255, 210, .06); backdrop-filter: blur(6px); }
  .status__win::before { content: ''; position: absolute; inset: 8px; border: 1px solid rgba(160, 240, 210, .2); border-radius: 12px; pointer-events: none; }
  .status__head { display: grid; grid-template-columns: auto 1fr; align-items: baseline; gap: 4px 16px; padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px dashed rgba(160, 240, 210, .35); }
  .status__head > span { color: #9cf0d0; letter-spacing: .3em; font-size: 12px; }
  .status__head h3 { margin: 0; font-family: var(--f-display); font-weight: 400; font-size: clamp(24px, 3vw, 40px); }
  .status__meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 6px 0 0; font-size: 14px; }
  .status__meta div { display: flex; gap: 8px; }
  .status__meta dt { color: #9cf0d0; }
  .status__meta dd { margin: 0; font-weight: 700; }
  .status__cols { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(220px, 1fr); gap: clamp(16px, 3vw, 40px); }
  .tech { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .tech__head { display: flex; justify-content: space-between; padding: 0 12px 6px; font-size: 11px; letter-spacing: .25em; color: #9cf0d0; }
  .tech__row { width: 100%; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) 3.2em; align-items: center; gap: 14px; padding: 10px 12px; border: 1px solid transparent; border-radius: 10px; background: none; text-align: left; transition: background .2s, border-color .2s; }
  .tech__row:hover, .tech__row:focus-visible { background: rgba(160, 240, 210, .08); border-color: rgba(160, 240, 210, .35); }
  .tech__name { font-weight: 700; }
  .tech__bar { height: 10px; border-radius: 99px; background: rgba(255, 255, 255, .1); overflow: hidden; }
  .tech__bar i { display: block; height: 100%; width: calc(var(--lv) * 100%); border-radius: inherit; background: linear-gradient(90deg, #4fd1a5, var(--yellow)); transform-origin: left; }
  .tech__rank { font-family: var(--f-display); font-size: 22px; text-align: center; color: var(--yellow); }
  .tech__rank.is-q { color: #ff8e7a; font-size: 16px; }
  .status__side { display: grid; align-content: start; }
  .loopbox { position: relative; aspect-ratio: 9 / 8; border: 2px solid rgba(160, 240, 210, .45); border-radius: 14px; overflow: hidden; background: #071012; }
  .loopbox__item { position: absolute; inset: 0; opacity: 0; transition: opacity .25s; }
  .loopbox__item.is-on { opacity: 1; }
  .loopbox__item .art, .loopbox__item img { width: 100%; height: 100%; }
  .loopbox__item img { object-fit: cover; }
  .loopbox__item .art--todo { border-radius: 0; border: 0; }
  .loopbox__cap { position: absolute; left: 10px; bottom: 8px; margin: 0; padding: 3px 8px; border-radius: 6px; background: rgba(0, 0, 0, .6); font-size: 11px; color: #9cf0d0; }
  .status__row { margin-top: 22px; padding-top: 18px; border-top: 1px dashed rgba(160, 240, 210, .35); }
  .status__row h4 { margin: 0 0 12px; font-size: 11px; font-weight: 400; letter-spacing: .3em; color: #9cf0d0; }
  .licenses { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .lic { position: relative; display: grid; gap: 2px; padding: 12px 14px; border-radius: 12px; border: 1.5px solid rgba(255, 255, 255, .25); overflow: hidden; }
  .lic b { font-family: var(--f-display); font-weight: 400; font-size: 22px; }
  .lic span { font-size: 12.5px; opacity: .8; }
  .lic--gold { border-color: #f5c84b; background: linear-gradient(135deg, rgba(245, 200, 75, .28), rgba(201, 138, 62, .12)); box-shadow: 0 0 24px rgba(245, 200, 75, .25); }
  .lic--gold b { color: #ffd76a; }
  .lic--charging { border-style: dashed; }
  .lic__charge { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: linear-gradient(90deg, transparent, #9cf0d0, transparent); animation: charge 1.8s linear infinite; }
  @keyframes charge { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
  .status__langs { margin: 0; line-height: 2.1; }
  .status__langs .chip { color: #9cf0d0; }

  .cka { display: grid; justify-items: center; gap: 18px; margin-top: clamp(80px, 14vh, 160px); }
  .cka__pre { margin: 0; font-size: 12px; letter-spacing: .25em; color: #9cf0d0; text-align: center; }
  .cka__stamp { display: grid; place-items: center; width: clamp(180px, 22vw, 260px); aspect-ratio: 1; border-radius: 50%; border: 8px double #f5c84b; color: #ffd76a; background: radial-gradient(circle, rgba(245, 200, 75, .2), transparent 70%); transform: rotate(-12deg); }
  .cka__stamp span { font-family: var(--f-display); font-size: clamp(56px, 7vw, 84px); line-height: 1; margin-top: 18%; }
  .cka__stamp small { font-family: var(--f-mono); font-size: 12px; letter-spacing: .2em; margin-bottom: 26%; }

  .form-flash { position: fixed; left: 0; right: 0; top: 50%; z-index: 55; height: clamp(120px, 22vh, 200px); transform: translateY(-50%) scaleY(0); display: grid; place-items: center; pointer-events: none;
    background: repeating-conic-gradient(#14271f 0 25%, #0b0d0c 0 50%) 0 0 / 48px 48px; border-block: 4px solid var(--ink); box-shadow: 0 0 0 3px #4fd1a5; }
  .form-flash p { margin: 0; padding: 0 24px; text-align: center; font-family: var(--f-brush); font-size: clamp(22px, 3.6vw, 52px); line-height: 1.15; color: #fff; text-shadow: 0 0 18px rgba(120, 220, 255, .8), 3px 3px 0 #000; }

  @media (max-width: 860px) {
    .status__cols { grid-template-columns: 1fr; }
    .status__side { max-width: 360px; }
    .licenses { grid-template-columns: 1fr; }
    .tech__row { grid-template-columns: minmax(0, 1fr) 70px 2.6em; gap: 10px; }
  }
</style>
