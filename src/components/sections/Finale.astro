---
import fs from 'node:fs';
import path from 'node:path';
import Art from '../Art.astro';
import { person } from '../../data/content.js';
import { withBase } from '../../lib/base.js';
const hasResume = fs.existsSync(path.join(process.cwd(), 'public', person.links.resume));
---
<section class="sc finale" id="ep06" data-ep="ep06" data-fx="eyecatch" data-ec="3" aria-labelledby="finale-h">
  <div class="finale__stage">
    <!-- GIF-06 is the whole scene: the BG-07 rooftop with our hero and Muffins already in it. -->
    <div class="finale__bg"><Art id="GIF-06" fallback="BG-07" sizes="100vw" alt="On a Kochi rooftop at sunset, our hero waves goodbye while Muffins sits at their feet" /></div>
    <div class="finale__grain" aria-hidden="true"></div>

    <div class="endcard">
      <p class="endcard__ml" lang="ml">തുടരും…</p>
      <p class="endcard__en mono">TO BE CONTINUED</p>
    </div>

    <div class="contact" data-fansub="Will our hero join your team? Find out next episode.">
      <p class="contact__k mono">NEXT SEASON</p>
      <h2 class="contact__h" id="finale-h">The Founder Arc</h2>
      <p class="contact__p">Open to platform, cloud-native and backend roles. Long-term: an infrastructure company. Say hi before the next episode airs.</p>
      <div class="contact__btns">
        <button class="btn btn--ink" type="button" data-copy-email={person.email}>Copy email</button>
        <a class="btn" href={person.links.github} target="_blank" rel="noopener">GitHub ↗</a>
        <a class="btn" href={person.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        <a class="btn" href={person.links.leetcode} target="_blank" rel="noopener">LeetCode ↗</a>
        {hasResume && <a class="btn btn--yellow" href={withBase(person.links.resume)} target="_blank" rel="noopener">Résumé ↗</a>}
      </div>
      <p class="contact__email mono"><a href={`mailto:${person.email}`}>{person.email}</a></p>
    </div>
  </div>
</section>

<style is:global>
  .finale { height: 100vh; height: 100svh; min-height: 620px; background: #f2a35e; color: var(--ink); }
  .finale__stage { position: absolute; inset: 0; overflow: hidden; }
  .finale__bg, .finale__bg .art, .finale__bg img { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* The hero stands right of centre in the scene, so the copy lives on the left. */
  .finale__bg img { object-fit: cover; object-position: 60% 72%; }
  .finale__stage::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(40, 14, 30, .6), rgba(40, 14, 30, .25) 45%, transparent 62%); }
  .finale__grain { position: absolute; inset: -50%; z-index: 4; pointer-events: none; opacity: 0; background-image: radial-gradient(rgba(0,0,0,.25) 1px, transparent 1px); background-size: 3px 3px; animation: grain .5s steps(4) infinite; }
  @keyframes grain { 25% { transform: translate(-1%, 1%); } 50% { transform: translate(1%, -1%); } 75% { transform: translate(-1%, -1%); } }

  .endcard { position: absolute; left: 30%; top: 40%; z-index: 5; transform: translate(-50%, -50%); text-align: center; color: var(--paper); text-shadow: 0 4px 30px rgba(0, 0, 0, .45); }
  .endcard__ml { margin: 0; font-family: var(--f-ml); font-weight: 800; font-size: clamp(56px, 9vw, 160px); line-height: 1.1; -webkit-text-stroke: 2px rgba(22, 19, 28, .5); }
  .endcard__en { margin: 0; letter-spacing: .5em; font-size: clamp(12px, 1.2vw, 16px); }

  .contact { position: absolute; left: var(--gutter); top: 0; bottom: 0; height: fit-content; margin-block: auto; z-index: 6; width: min(560px, calc(100% - var(--gutter) * 2)); padding: clamp(20px, 3vw, 34px); background: var(--paper); border: 3px solid var(--ink); border-radius: 22px; box-shadow: 10px 10px 0 var(--ink); }
  .contact__k { margin: 0; font-size: 12px; letter-spacing: .3em; color: var(--red); }
  .contact__h { margin: 4px 0 10px; font-family: var(--f-display); font-weight: 400; font-size: clamp(34px, 4.4vw, 64px); line-height: 1; }
  .contact__p { margin: 0 0 18px; font-weight: 700; }
  .contact__btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .contact__email { margin: 16px 0 0; font-size: 13px; opacity: .7; word-break: break-all; }

  html.js .finale.is-anim .endcard { opacity: 0; }
  html.js .finale.is-anim .contact { opacity: 0; }

  @media (max-width: 800px) {
    .finale { height: auto; min-height: 0; background: #2a1830; }
    .finale__stage { position: relative; display: grid; align-content: end; padding: 0 var(--gutter) 90px; }
    /* Phone: the scene sits on top, framed on our hero, and fades into the page. */
    .finale__bg { bottom: auto; height: 68svh; }
    .finale__bg .art, .finale__bg img { height: 100%; }
    .finale__bg img { object-position: 64% 80%; }
    .finale__bg::after { content: ''; position: absolute; inset: auto 0 0; height: 30%; background: linear-gradient(transparent, #2a1830); }
    .finale__stage::after { background: linear-gradient(rgba(40, 14, 30, .45), transparent 30%); }
    .endcard { left: 50%; top: max(96px, 13svh); }
    .contact { position: relative; left: auto; top: auto; bottom: auto; width: 100%; margin-top: 58svh; }
  }
</style>
