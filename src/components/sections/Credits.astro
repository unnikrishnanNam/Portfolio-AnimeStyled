---
import Art from '../Art.astro';
import { credits, person } from '../../data/content.js';
---
<section class="sc credits" id="credits" data-ep="ep06" aria-labelledby="credits-h">
  <div class="credits__pin">
    <div class="credits__roll">
      <h2 class="credits__h" id="credits-h">Debug, Deploy,<br />Adventure, Repeat</h2>
      <dl class="credits__list">
        {credits.map(([role, names]) => (
          <div><dt>{role}</dt>{(names as string[]).map((n) => <dd>{n}</dd>)}</div>
        ))}
      </dl>
      <p class="credits__links">
        <a href={person.links.github} target="_blank" rel="noopener">GitHub</a>
        <a href={person.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={person.links.leetcode} target="_blank" rel="noopener">LeetCode</a>
        <a href={`mailto:${person.email}`}>Email</a>
      </p>
    </div>
  </div>

  <div class="post">
    <p class="post__k mono">POST-CREDITS SCENE</p>
    <div class="post__floor">
      <div class="post__dog">
        <span class="post__trot"><Art id="GIF-07" fallback="MUF-01" sizes="200px" alt="Muffins trots in and sits on the button" /></span>
        <span class="post__sit" aria-hidden="true"><Art id="MUF-01" sizes="200px" alt="" /></span>
      </div>
      <button class="post__btn btn btn--yellow" type="button" data-rewind>↑ Back to episode 0</button>
    </div>
    <p class="post__fine">© 2026 {person.name}. Illustrations generated with AI from the author’s own photos. Built with Astro, GSAP and Lenis. No Shih Tzus were harmed; one was mildly inconvenienced.</p>
  </div>
</section>

<style is:global>
  .credits { background: #000; color: #e9e4d8; }
  .credits__pin { position: relative; height: 100vh; overflow: hidden; display: grid; justify-items: center; }
  .credits__roll { width: min(560px, 100% - var(--gutter) * 2); text-align: center; padding: 100vh 0 20vh; will-change: transform; }
  .credits__h { margin: 0 0 18vh; font-family: var(--f-display); font-weight: 400; font-size: clamp(30px, 4vw, 54px); line-height: 1.05; }
  .credits__list { margin: 0; display: grid; gap: 7vh; }
  .credits__list dt { font-family: var(--f-mono); font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: #8d877b; margin-bottom: 8px; }
  .credits__list dd { margin: 0; font-size: clamp(18px, 1.8vw, 24px); font-weight: 700; line-height: 1.4; }
  .credits__links { display: flex; justify-content: center; flex-wrap: wrap; gap: 18px; margin: 14vh 0 0; }
  .credits__links a { color: var(--yellow); }
  .credits.is-static .credits__pin { height: auto; }
  .credits.is-static .credits__roll { padding: 120px 0 60px; }

  .post { position: relative; padding: 60px var(--gutter) 100px; display: grid; justify-items: center; gap: 16px; text-align: center; }
  .post__k { margin: 0; font-size: 11px; letter-spacing: .3em; color: #8d877b; }
  .post__floor { position: relative; display: grid; justify-items: center; padding-top: 128px; }
  .post__dog { position: absolute; top: 0; left: 50%; width: 104px; margin-left: -52px; z-index: 2; pointer-events: none; }
  .post__dog img { width: 100%; height: auto; }
  /* She trots in (GIF-07), then sits once she arrives (MUF-01). */
  .post__dog > span { display: block; }
  .post__sit { position: absolute; left: 6%; right: 6%; bottom: 0; opacity: 0; }
  .post__dog.is-sat .post__trot { opacity: 0; }
  .post__dog.is-sat .post__sit { opacity: 1; }
  .post__dog .art--todo { aspect-ratio: 1; min-height: 0; color: #777; }
  .post__btn { position: relative; z-index: 1; }
  .post__fine { max-width: 60ch; margin: 30px 0 0; font-size: 12.5px; color: #7b766c; }
</style>
