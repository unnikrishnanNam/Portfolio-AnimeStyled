---
import fs from 'node:fs';
import path from 'node:path';
import { episodes, person } from '../../data/content.js';
const hasResume = fs.existsSync(path.join(process.cwd(), 'public', person.links.resume));
const all = [
  ...episodes.map((e) => ({ label: `Jump to EP.${e.n} ${e.name}`, act: `goto:${e.id}`, hint: '↵', keys: `episode ${e.short} ${e.ml}` })),
  { label: 'Jump to the end credits', act: 'goto:credits', hint: '↵', keys: 'credits footer' },
  { label: 'Copy email address', act: 'copy-email', hint: 'copy', keys: 'mail contact email hire' },
  { label: 'Open GitHub', act: `open:${person.links.github}`, hint: '↗', keys: 'code repos github' },
  { label: 'Open LinkedIn', act: `open:${person.links.linkedin}`, hint: '↗', keys: 'linkedin cv' },
  { label: 'Open résumé', act: `open:${person.links.resume}`, hint: '↗', keys: 'resume cv pdf', resume: true },
  { label: 'Pet Muffins', act: 'pet', hint: '🐾', keys: 'dog muffins pet' },
  { label: 'Toggle super mode', act: 'super', hint: '↑↑↓↓', keys: 'konami rage super' },
  { label: 'Toggle sound effects', act: 'sfx', hint: 'SFX', keys: 'sound audio sfx' },
];
const items = all.filter((it) => !it.resume || hasResume);
---
<dialog class="palette" id="palette" aria-label="Command palette">
  <form method="dialog" class="palette__box" autocomplete="off">
    <label class="palette__field">
      <span aria-hidden="true">›</span>
      <input id="palette-in" type="text" placeholder='Search, or try "kubectl get episodes"' spellcheck="false" aria-controls="palette-list" />
    </label>
    <ul class="palette__list" id="palette-list" role="listbox">
      {items.map((it, i) => (
        <li role="option" aria-selected={i === 0 ? 'true' : 'false'} data-act={it.act} data-keys={it.keys}>
          <span>{it.label}</span><kbd>{it.hint}</kbd>
        </li>
      ))}
    </ul>
    <pre class="palette__out" id="palette-out" hidden></pre>
    <p class="palette__foot"><span>↑↓ to move · ↵ to run · esc to close</span><span>try: <code>kubectl logs muffins</code></span></p>
  </form>
</dialog>

<style is:global>
  .palette { width: min(640px, calc(100% - 32px)); margin: 14vh auto auto; padding: 0; border: 0; background: transparent; color: #eae6dc; font-family: var(--f-mono); font-size: 14px; }
  .palette::backdrop { background: rgba(10, 8, 14, .55); backdrop-filter: blur(6px); }
  .palette__box { background: #121016; border: 1px solid #2c2933; border-radius: 16px; box-shadow: 0 30px 80px rgba(0,0,0,.5), 0 0 0 1px #000; overflow: hidden; }
  .palette__field { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid #24212a; }
  .palette__field span { color: var(--yellow); font-weight: 700; }
  .palette__field input { flex: 1; min-width: 0; background: none; border: 0; outline: none; font-size: 15px; }
  .palette__list { list-style: none; margin: 0; padding: 6px; max-height: min(52vh, 420px); overflow: auto; }
  .palette__list li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: 10px; cursor: pointer; }
  .palette__list li[aria-selected="true"] { background: #221f29; color: #fff; box-shadow: inset 3px 0 0 var(--yellow); }
  .palette__list kbd { font-family: inherit; color: #8d8899; }
  .palette__out { margin: 0; padding: 16px 18px; max-height: 52vh; overflow: auto; color: #9fe39a; font-size: 13px; line-height: 1.55; white-space: pre; }
  .palette__foot { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin: 0; padding: 10px 16px; border-top: 1px solid #24212a; color: #77727f; font-size: 11.5px; }
  .palette__foot code { color: #b9b3c5; }
</style>
