---
import { episodes } from '../../data/content.js';
---
<nav class="notch" id="notch" aria-label="Episodes">
  <button class="notch__pill" type="button" aria-expanded="false" aria-controls="notch-panel">
    <span class="notch__cam" aria-hidden="true"></span>
    <span class="notch__ep"><b data-notch-no>EP.00</b><span data-notch-name>OP</span></span>
    <svg class="notch__ring" viewBox="0 0 36 36" aria-hidden="true">
      <circle cx="18" cy="18" r="15" />
      <circle class="notch__prog" cx="18" cy="18" r="15" pathLength="100" />
    </svg>
    <span class="sr-only">Open episode menu</span>
  </button>
  <div class="notch__panel" id="notch-panel">
    <div class="notch__inner">
      <ol class="notch__eps">
        {episodes.map((e) => (
          <li><a href={`#${e.id}`} data-goto={e.id}><b>EP.{e.n}</b> {e.short}</a></li>
        ))}
      </ol>
      <div class="notch__row">
        <button type="button" data-notch-prev>◀ Prev</button>
        <button type="button" data-notch-next>Next ▶</button>
        <button type="button" data-sfx aria-pressed="false">SFX <span data-sfx-label>off</span></button>
        <button type="button" data-palette-open aria-label="Open command palette"><kbd>⌘K</kbd></button>
      </div>
    </div>
  </div>
</nav>

<style is:global>
  /* One fixed width, so the pill, the panel and the corner ears always line up and stay centred.
     Opening widens it, like the Dynamic Island. */
  .notch { --w: 250px; position: fixed; top: 0; left: 50%; z-index: 90; width: var(--w); transform: translate(-50%, -110%); transition: transform .6s var(--ease-out), width .45s var(--ease-out); color: #f4f1ea; font-family: var(--f-mono); font-size: 12px; }
  .notch.is-open { --w: min(440px, calc(100vw - 24px)); }
  html.notch-ready .notch { transform: translate(-50%, 0); }
  .notch__pill, .notch__panel { background: #000; }
  .notch__pill { display: flex; align-items: center; gap: 10px; width: 100%; height: 34px; padding: 0 12px 2px 14px; border: 0; border-radius: 0 0 18px 18px; transition: border-radius .3s; }
  .notch.is-open .notch__pill { border-radius: 0; }
  .notch__cam { width: 7px; height: 7px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #3c4b6b, #0b0d14 70%); box-shadow: 0 0 0 1.5px #15171d; }
  .notch__ep { flex: 1; display: flex; gap: 8px; align-items: baseline; justify-content: center; white-space: nowrap; }
  .notch__ep b { color: var(--yellow); font-weight: 700; }
  .notch__ring { width: 20px; height: 20px; transform: rotate(-90deg); }
  .notch__ring circle { fill: none; stroke: rgba(255,255,255,.18); stroke-width: 4; }
  .notch__ring .notch__prog { stroke: var(--yellow); stroke-dasharray: 100; stroke-dashoffset: 100; stroke-linecap: round; }
  .notch__panel { display: grid; grid-template-rows: 0fr; border-radius: 0 0 22px 22px; transition: grid-template-rows .45s var(--ease-out); }
  .notch.is-open .notch__panel { grid-template-rows: 1fr; }
  .notch__inner { overflow: hidden; min-height: 0; }
  .notch__eps { list-style: none; margin: 0; padding: 6px 12px 4px; min-width: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px 8px; }
  .notch__eps a { display: block; padding: 6px 8px; border-radius: 8px; text-decoration: none; color: #cfcab9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .notch__eps a b { color: #fff; }
  .notch__eps a:hover, .notch__eps a.is-current { background: #1d1b22; color: #fff; }
  .notch__eps a.is-current b { color: var(--yellow); }
  .notch__row { display: flex; gap: 6px; padding: 6px 12px 12px; }
  .notch__row button { flex: 1 1 0; min-width: 0; padding: 7px 6px; border: 1px solid #2c2933; border-radius: 9px; background: #121016; font-size: 11.5px; white-space: nowrap; }
  .notch__row button:hover { background: #1f1c25; border-color: #46414f; }
  .notch__row kbd { font-family: inherit; }
  html.sfx-on [data-sfx] { color: var(--yellow); border-color: var(--yellow); }
  @media (max-width: 520px) { .notch { --w: 210px; } .notch.is-open { --w: calc(100vw - 16px); } }
</style>
