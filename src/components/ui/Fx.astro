---
// Full-screen transition layer. fx.js drives these layers.
import Art from '../Art.astro';
---
<div class="fx" id="fx" aria-hidden="true">
  <div class="fx__tone"></div>
  <div class="fx__lines speedlines"></div>
  <div class="fx__flash"></div>
  <div class="fx__slash">
    <i></i><i></i><i></i>
  </div>
  <div class="fx__eye">
    <div class="fx__eyecard">
      <div class="fx__eyeart" data-ec="1"><Art id="EC-01" fallback={['MUF-03', 'MUF-01']} sizes="60vw" eager fetchpriority="low" /></div>
      <div class="fx__eyeart" data-ec="2" hidden><Art id="EC-02" fallback={['MUF-02', 'MUF-01']} sizes="60vw" eager fetchpriority="low" /></div>
      <div class="fx__eyeart" data-ec="3" hidden><Art id="EC-03" fallback={['MUF-01']} sizes="60vw" eager fetchpriority="low" /></div>
      <p class="fx__logo"><span>Debug,</span> <span>Deploy,</span> <span>Adventure,</span> <span>Repeat</span></p>
      <p class="fx__eyelabel">EYECATCH</p>
    </div>
  </div>
  <div class="fx__power">
    <div class="fx__aura"></div>
    <div class="fx__rage"><Art id="R-02" sizes="60vw" eager fetchpriority="low" /></div>
  </div>
  <div class="fx__ink">
    <svg viewBox="0 0 200 200">
      <path d="M100 18c14 0 18 22 30 24s30-14 38-2-12 26-6 38 30 14 26 28-28 6-36 16 2 34-12 40-20-18-36-18-28 26-40 18 2-30-8-40-38-4-40-18 26-18 26-32-24-22-14-32 30 8 40-2 14-22 32-22z" />
      <g class="ink__drops"><circle cx="28" cy="40" r="7" /><circle cx="176" cy="58" r="5" /><circle cx="186" cy="150" r="8" /><circle cx="22" cy="168" r="6" /><circle cx="104" cy="194" r="4" /><circle cx="150" cy="12" r="4" /></g>
    </svg>
  </div>
  <div class="fx__fade"></div>
</div>

<style is:global>
  .fx { position: fixed; inset: 0; z-index: 150; pointer-events: none; }
  .fx.is-active { pointer-events: auto; }
  .fx > * { position: absolute; inset: 0; visibility: hidden; }
  .fx__tone { --r: 0px; background: radial-gradient(circle, var(--ink) var(--r), transparent calc(var(--r) + .6px)) 50% 50% / 28px 28px; }
  .fx__lines { color: var(--ink); background-color: transparent; }
  .fx__flash { background: #fff; mix-blend-mode: difference; }
  .fx__slash i { position: absolute; left: -10%; width: 120%; height: 40%; background: var(--ink); border-block: 6px solid var(--paper); transform: skewY(-8deg); }
  .fx__slash i:nth-child(1) { top: -6%; }
  .fx__slash i:nth-child(2) { top: 30%; background: var(--red); }
  .fx__slash i:nth-child(3) { top: 66%; }
  .fx__eye { display: grid; place-items: center; background: var(--yellow); perspective: 1200px; }
  .fx__eye::before { content: ''; position: absolute; inset: 0; color: rgba(22,19,28,.12); background: radial-gradient(circle, currentColor 2px, transparent 2.6px) 0 0 / 22px 22px; }
  .fx__eyecard { position: relative; width: min(880px, 88vw); aspect-ratio: 16 / 9; display: grid; place-items: center; background: var(--paper); border: 6px solid var(--ink); border-radius: 28px; box-shadow: 14px 14px 0 var(--ink); overflow: hidden; }
  .fx__eyeart { position: absolute; inset: 6% 6% 18% 40%; }
  .fx__eyeart .art, .fx__eyeart img { width: 100%; height: 100%; }
  .fx__eyeart img { object-fit: contain; }
  .fx__logo { position: absolute; left: 6%; top: 50%; transform: translateY(-50%) rotate(-4deg); margin: 0; display: grid; font-family: var(--f-display); font-size: clamp(22px, 4.4vw, 54px); line-height: .98; text-transform: uppercase; }
  .fx__logo span:nth-child(2) { color: var(--sky); }
  .fx__logo span:nth-child(3) { color: var(--red); }
  .fx__logo span:nth-child(4) { -webkit-text-stroke: 2px var(--ink); color: var(--yellow); paint-order: stroke fill; }
  /* Real eyecatch art: fill the card, match its flat colour, put the logo in the blank area. */
  .fx__eye[data-on="1"] { background: #ffd23f; }
  .fx__eye[data-on="2"] { background: #2e9beb; }
  .fx__eye[data-on="3"] { background: #f57a1e; }
  .fx__eye[data-on]:not([data-on=""]) .fx__eyecard { background: transparent; }
  .fx__eye[data-on] .fx__eyeart:has([data-art^="EC-"]) { inset: 0; }
  .fx__eye[data-on] .fx__eyeart:has([data-art^="EC-"]) img { object-fit: cover; }
  .fx__eye[data-on="1"] .fx__logo, .fx__eye[data-on="2"] .fx__logo, .fx__eye[data-on="3"] .fx__logo { z-index: 1; }
  .fx__eye[data-on="1"] .fx__logo { left: 5%; }
  .fx__eye[data-on="2"] .fx__logo { left: auto; right: 5%; text-align: right; transform: translateY(-50%) rotate(4deg); }
  .fx__eye[data-on="3"] .fx__logo { left: 50%; top: 8%; transform: translateX(-50%) rotate(-3deg); text-align: center; font-size: clamp(20px, 3.6vw, 46px); }
  .fx__eye[data-on="2"] .fx__logo span, .fx__eye[data-on="3"] .fx__logo span { color: var(--paper); -webkit-text-stroke: 2px var(--ink); paint-order: stroke fill; text-shadow: 3px 3px 0 var(--ink); }
  .fx__eye[data-on="2"] .fx__logo span:nth-child(odd), .fx__eye[data-on="3"] .fx__logo span:nth-child(even) { color: var(--yellow); }
  .fx__eye[data-on="3"] .fx__logo { grid-template-columns: auto auto; justify-content: center; gap: 0 .35em; width: max-content; }
  .fx__eye[data-on="2"] .fx__eyelabel, .fx__eye[data-on="3"] .fx__eyelabel { color: var(--paper); }
  .fx__eyelabel { position: absolute; right: 4%; bottom: 3%; margin: 0; font-family: var(--f-display); letter-spacing: .3em; font-size: clamp(11px, 1.2vw, 15px); }
  .fx__power { display: grid; place-items: center; overflow: hidden; }
  .fx__aura { position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, #fff2 0, var(--red) 30%, #7a0d0a 75%); clip-path: circle(0% at 50% 50%); }
  .fx__rage { position: relative; width: min(560px, 70vw); border: 5px solid var(--ink); border-radius: 18px; overflow: hidden; box-shadow: 0 0 0 6px var(--red), 0 0 80px 20px rgba(255, 60, 40, .7); }
  .fx__rage img { width: 100%; height: auto; }
  .fx__fade { background: var(--ink); }
  .fx__ink { --hole: 0px; display: grid; place-items: center; overflow: hidden; -webkit-mask: radial-gradient(circle at 50% 50%, transparent var(--hole), #000 calc(var(--hole) + 1px)); mask: radial-gradient(circle at 50% 50%, transparent var(--hole), #000 calc(var(--hole) + 1px)); }
  .fx__ink svg { width: 42vmax; overflow: visible; fill: #0b0d18; }
  .fx__ink circle { transform-box: fill-box; transform-origin: center; }
</style>
